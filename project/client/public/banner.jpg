en\":[\"$\",\"$3\",null,{\"name\":\"Next.MetadataOutlet\",\"children\":\"$@18\"}]}]]}]\n19:[]\nd:\"$W19\"\ne:[\"$\",\"$1\",\"h\",{\"children\":[null,[\"$\",\"$L1a\",null,{\"children\":\"$L1b\"}],[\"$\",\"div\",null,{\"hidden\":true,\"children\":[\"$\",\"$L1c\",null,{\"children\":[\"$\",\"$3\",null,{\"name\":\"Next.Metadata\",\"children\":\"$L1d\"}]}]}],[\"$\",\"meta\",null,{\"name\":\"next-size-adjust\",\"content\":\"\"}]]}]\n10:[\"$\",\"link\",\"0\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/13xxwks7hzya2.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n11:[\"$\",\"link\",\"1\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/01w1wpw8z7-sb.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n12:[\"$\",\"link\",\"2\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/157k_dg4ym0pd.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n13:[\"$\",\"link\",\"3\",{\"rel\":\"stylesheet\",\"href\":\"/_next/static/chunks/0xdxb2ff1jgst.css\",\"precedence\":\"next\",\"crossOrigin\":\"$undefined\",\"nonce\":\"$undefined\"}]\n"])</script><script>self.__next_f.push([1,"4:[\"$\",\"$L1e\",null,{\"formats\":\"$undefined\",\"locale\":\"en\",\"messages\":{\"landing\":{\"hero\":{\"title\":\"Build your own \u003cbrMobile\u003e\u003c/brMobile\u003e\u003ctyping\u003e\u003c/typing\u003e,\u003cbr\u003e\u003c/br\u003ein minutes.\",\"typing\":{\"app\":\"App\",\"product\":\"Product\",\"onlineBusiness\":\"Online Business\"},\"description\":\"No coding. No tech skills. Just describe your idea and we'll build it for you.\"},\"sections\":{\"videoTitle\":\"See how it works\",\"whoIsThisForTitle\":\"Perfect for everyone\",\"whoIsThisForDescription\":\"Whether you're just starting with an idea or scaling an existing business\",\"featuresTitle\":\"Everything you need\",\"featuresDescription\":\"All the features you need to build, launch, and grow your app\",\"testimonialsTitle\":\"Turning Ideas Into Reality\",\"testimonialsDescription\":\"Real stories from real builders who transformed their ideas into successful apps\"},\"features\":{\"tellUsYourIdea\":{\"title\":\"Just Tell Us Your Idea\",\"description\":\"Describe your vision in everyday language, and we'll bring it to life instantly.\"},\"usersReadyToGo\":{\"title\":\"Users Ready to Go\",\"description\":\"People can sign up and start using your app right away—no setup needed.\"},\"aiPoweredMagic\":{\"title\":\"AI-Powered Magic\",\"description\":\"Your app provides personalized experiences using the power of AI and your unique knowledge.\"},\"startEarning\":{\"title\":\"Start Earning While You Sleep\",\"description\":\"Create different access levels and subscription tiers to generate passive income.\"},\"shareYourKnowledge\":{\"title\":\"Share Your Knowledge\",\"description\":\"Upload your content, ideas, or expertise and make it accessible to others.\"},\"worksEverywhere\":{\"title\":\"Works Everywhere\",\"description\":\"Your creation looks amazing on phones, tablets, and computers.\"}},\"testimonials\":[{\"quote\":\"With BuildAI, I quickly created my own AI-powered nutrition app that truly serves my audience. My users love the smart meal tracking and instant feedback... No coding needed!\",\"author\":\"Melissa McAllister\",\"role\":\"Nutritional Therapy Practitioner\"},{\"quote\":\"…I tossed it a rough idea—barely a sketch—and it spit out a full-on product AND fixed problems I never saw with my idea, it's unbelievable…\",\"author\":\"Jared Walker\",\"role\":\"Golf Community Lead\"},{\"quote\":\"BuildAI helped me create a Glucose Guide assistant app, which made healthy living with diabetes easier for my audience. All without writing a single line of code!\",\"author\":\"Mila Clarke\",\"role\":\"Diabetes Health \u0026 Wellness Coach / Nutritionist\"}],\"faq\":{\"title\":\"Frequently Asked Questions\",\"questions\":[{\"question\":\"Do I need technical skills to bring my idea to life?\",\"answer\":\"Not at all! Just describe what you envision, and we'll create it for you. No coding, no technical background needed.\"},{\"question\":\"How quickly can I see my idea come to life?\",\"answer\":\"Your app is created instantly based on your idea. After a few tweaks to make it perfect, you can share it with the world within hours.\"},{\"question\":\"How does the AI personalization work?\",\"answer\":\"Your app uses AI to provide personalized experiences to each user based on their needs, powered by your unique knowledge and expertise.\"},{\"question\":\"What kind of ideas work best?\",\"answer\":\"Any idea where you can help people! Personalized recommendations, creative tools, learning assistants, wellness guides, hobby communities—if you have knowledge or passion, we can turn it into an app.\"},{\"question\":\"Can I make it look like my own thing?\",\"answer\":\"Absolutely! Customize colors, add your logo, change layouts to match your style. Premium plans also let you use your own web address.\"},{\"question\":\"Can I add my own content and knowledge?\",\"answer\":\"Yes! Upload your content, expertise, or resources to make them accessible to your users in a smart, organized way.\"}]},\"useCases\":{\"title\":\"What will you \u003chighlight\u003ebuild\u003c/highlight\u003e today?\",\"description\":\"With BuildAI you can create apps, tools, and digital products for anything\",\"categories\":[\"Personal Tools\",\"SaaS Products\",\"Business Tools\",\"AI Tools\",\"Customer Portals\",\"Internal Tools\",\"Ecommerce\",\"Dashboards\",\"Community Apps\"],\"tryExample\":\"Or try an example\",\"examples\":[{\"category\":\"Habit Tracker\",\"prompt\":\"Create a personal habit tracker app that reminds me to drink water and tracks my daily goals\"},{\"category\":\"Project Manager\",\"prompt\":\"Build a project management tool where teams can collaborate on tasks and track progress\"},{\"category\":\"Invoice Generator\",\"prompt\":\"Create an invoice generator that automatically calculates taxes and sends payment reminders\"},{\"category\":\"AI Writer\",\"prompt\":\"Build an AI writing assistant that helps create social media content based on my brand voice\"},{\"category\":\"Support Portal\",\"prompt\":\"Create a customer support portal where users can submit tickets and track their status\"},{\"category\":\"Employee Directory\",\"prompt\":\"Build an employee directory app with contact info and skill matching for projects\"},{\"category\":\"Online Store\",\"prompt\":\"Create an online store for handmade jewelry with payment processing and inventory tracking\"},{\"category\":\"Sales Dashboard\",\"prompt\":\"Build a sales dashboard that visualizes revenue trends and customer analytics\"},{\"category\":\"Community Forum\",\"prompt\":\"Create a local community forum where neighbors can share events and recommendations\"}]},\"whoIsThisFor\":{\"ideaMakers\":{\"title\":\"Idea Makers\",\"description\":\"Turn that brilliant idea floating in your head into something real people can use and love.\"},\"passionateCreators\":{\"title\":\"Passionate Creators\",\"description\":\"You have knowledge, skills, or an audience. Now turn that passion into an app that serves others.\"},\"businessOwners\":{\"title\":\"Business Owners\",\"description\":\"Expand your business with a digital product that serves your customers 24/7.\"}},\"cta\":{\"title\":\"Turn Your Idea Into Something Real\",\"description\":\"Join thousands of builders who turned their passions into apps that people love\",\"button\":\"Start Building Today\"},\"navigation\":{\"home\":\"Home\",\"templates\":\"Templates\",\"useCases\":\"Use Cases\",\"aiTools\":\"AI Tools\",\"industries\":\"Industries\",\"agents\":\"Digital Employees\",\"myAgents\":\"My Team\",\"pricing\":\"Pricing\",\"community\":\"Community\",\"signIn\":\"Sign In\",\"myApps\":\"My Apps\",\"tagline\":\"Build AI Apps Fast\",\"buildServiceBanner\":{\"text\":\"Need help launching faster? Try our Done-For-You App Build Service\"},\"language\":\"Language\",\"dropdowns\":{\"useCases\":{\"title\":\"Use Cases\",\"featuredTitle\":\"Featured Use Cases\",\"byGoal\":\"By Goal\",\"byBusinessType\":\"By Business Type\",\"viewAll\":\"View all use cases\",\"goals\":{\"get-customers\":\"Get Customers\",\"increase-sales\":\"Increase Sales\",\"save-time\":\"Save Time\",\"automate-workflows\":\"Automate Workflows\",\"build-presence\":\"Build Online Presence\",\"generate-quotes\":\"Generate Reports/Quotes\"},\"businessTypes\":{\"service-providers\":\"Service Providers\",\"creators-educators\":\"Creators \u0026 Educators\",\"local-businesses\":\"Local Businesses\",\"agencies-freelancers\":\"Agencies \u0026 Freelancers\",\"industry-professionals\":\"Industry Professionals\",\"entrepreneurs\":\"Entrepreneurs\"}},\"aiTools\":{\"title\":\"AI Tools\",\"featuredTitle\":\"Featured AI Tools\",\"viewAll\":\"View all AI tools\"},\"industries\":{\"title\":\"Industries\",\"byIndustry\":\"Browse by industry\",\"viewAll\":\"View all industries\"}}},\"footer\":{\"tagline\":\"Build AI Apps Fast\",\"description\":\"Create AI-powered apps \u0026 digital employees instantly without code\",\"sections\":{\"company\":{\"title\":\"Company\",\"affiliates\":\"Affiliates\",\"contactUs\":\"Contact Us\"},\"aiTools\":{\"title\":\"AI Tools\",\"instagramToApp\":\"Instagram Digital Products\",\"tripPlannerAi\":\"Trip Planner AI\",\"proPicCreator\":\"ProPic Creator\",\"reelify\":\"Reelify\"},\"more\":{\"title\":\"More\",\"community\":\"Community\",\"pricing\":\"Pricing\",\"appBuildService\":\"App Build Service\",\"buildaiHub\":\"BuildAI Hub\",\"termsOfService\":\"Terms of Service\",\"privacyPolicy\":\"Privacy Policy\"}},\"copyright\":\"© 2026 BuildAI.Space LTD. All rights reserved.\",\"madeWith\":\"Made with 💜 for builders worldwide\"},\"newHero\":{\"title\":\"Build custom apps\",\"titleHighlight\":\"like talking\",\"titleEnd\":\"to a friend\",\"description\":\"All-in-one AI apps \u0026 websites builder. No code. Easier than ever.\",\"buildButton\":\"Build My App\",\"pricingNote\":\"Plans start from $25 a month\",\"promptBuilder\":\"Prompt Builder\",\"placeholderMobile\":\"Describe your idea... (e.g. Build a client portal)\",\"placeholderDesktop\":\"Describe your idea... (e.g. Build a client portal where my customers can access their projects, make payments, and communicate with my team)\",\"businessCtaMobile\":\"Running a business? \",\"businessCtaDesktop\":\"Want to automate workflows and grow revenue? \",\"seeSolutionsMobile\":\"See proven solutions\",\"seeSolutionsDesktop\":\"See proven solutions that save time and increase sales\",\"talkToBuildAI\":\"Not sure? Let BuildAI help you ideate\",\"agentsBadge\":\"New\",\"agentsAnnouncement\":\"Meet your personal digital employee — works for you 24/7\",\"agentsAnnouncementMobile\":\"Meet your personal digital employee\"},\"voiceIdeator\":{\"clickToStart\":\"Click to start talking\",\"connecting\":\"Connecting...\",\"listening\":\"Listening...\",\"clickMicToTalk\":\"Click the mic to talk\",\"takingToBuilder\":\"Taking you to the builder...\",\"clickToStartPlaceholder\":\"Hi! I'm here to help you build your idea, or brainstorm to get to one. Click to start talking!\",\"tellMeAboutYourApp\":\"Tell me about your app or business idea\",\"typeYourMessage\":\"Or type your message...\",\"preferToType\":\"Prefer to type? Use text builder\",\"enableSound\":\"Enable sound\",\"soundOn\":\"Sound on\",\"muteSound\":\"Mute sound\",\"tip1\":\"I can help you build your business idea, or brainstorm to get to one if you're not sure yet. What's on your mind?\",\"tip2\":\"I can help you automate tasks that eat up your day - scheduling, invoicing, follow-ups. What's taking too much of your time?\",\"tip3\":\"Whether you're launching a new business or scaling an existing one, the right tools make all the difference. Let's build yours.\",\"tip4\":\"Your competitors are using custom software to move faster. Let me help you catch up - or get ahead.\",\"tip5\":\"From client portals to inventory systems, I've helped thousands of businesses work smarter. What would help yours?\",\"tip6\":\"Imagine connecting all your business tools into one flow. I can help you design AI workflows that save hours every week.\",\"startBuilding\":\"Start Building\",\"keepRefining\":\"Keep Refining\",\"endSession\":\"End Session\",\"noisyEnvironmentHint\":\"Mute \u0026 type in noisy environment\",\"clickToEdit\":\"Click to edit\",\"promptReady\":\"Your app is ready!\",\"tip7\":\"Need to process customer data faster? I can help you build digital employees that handle inquiries, orders, and support 24/7.\",\"noisyRoom\":\"Noisy room?\",\"mute\":\"Mute\",\"status\":{\"connectingPlaceholder\":\"Connecting to help you ideate...\"}},\"theShift\":{\"title\":\"Watch how easy it is\",\"description\":\"From idea to working app in minutes. No coding required\",\"messageTitle\":\"Software used to be for tech companies.\",\"messageTitleHighlight\":\"Not anymore.\",\"messageDescription\":\"The most competitive businesses don't just use software, they build it. Custom tools that fit exactly how they work, serve exactly who they serve, and do exactly what they need. That used to require engineers and months of development.\",\"messageDescriptionBold\":\"Now it takes minutes and a conversation.\"},\"threePaths\":{\"title\":\"What will you build?\",\"launchProduct\":{\"title\":\"Launch a product\",\"description\":\"You have the idea. Now you can build it. Without a technical co-founder, without raising money, without waiting. Describe your vision, launch your product, get paying customers.\"},\"serveCustomers\":{\"title\":\"Serve your customers\",\"description\":\"Build apps or websites that deliver your expertise, your content, your services, on autopilot. Personalized AI experiences your customers pay for, month after month.\"},\"runOperations\":{\"title\":\"Run your operations\",\"description\":\"Stop duct-taping spreadsheets and generic tools. Build the internal systems your business actually needs: client portals, workflows, dashboards, intake forms. Custom fit to you.\"}},\"howItWorks\":{\"title\":\"From idea to live app\",\"titleHighlight\":\"in three steps\",\"description\":\"We handle the complexity of databases, authentication, and deployment. You handle the vision.\",\"steps\":{\"describe\":{\"title\":\"Describe it\",\"description\":\"Tell us what you need like you'd tell a colleague\"},\"build\":{\"title\":\"Build it\",\"description\":\"Get a working app with AI, payments, and users built in\"},\"launch\":{\"title\":\"Launch it\",\"description\":\"Go live on your domain, start growing immediately\"}}},\"newFeatures\":{\"title\":\"Everything you need.\",\"titleHighlight\":\"None of the headaches.\",\"groups\":{\"database\":{\"title\":\"Built-in database \u0026 user management\",\"features\":[\"Powerful database included, no setup required\",\"User authentication and management out of the box\",\"Role-based access control for your users\"]},\"payments\":{\"title\":\"Payments \u0026 subscriptions\",\"features\":[\"Add payments and subscriptions in minutes\",\"Create tiers, gate access, generate recurring revenue\",\"Your customers, your revenue, your business\"]},\"ai\":{\"title\":\"AI-powered features \u0026 digital employees\",\"features\":[\"AI that learns from your content and knowledge\",\"Build digital employees that work for your users 24/7\",\"Personalized intelligent experiences for everyone\"]},\"integrations\":{\"title\":\"Integrations to any tool or service\",\"features\":[\"Connect to thousands of tools and services\",\"Automate workflows across your favorite apps\",\"Full branding, your domain, your business\"]}}},\"reframe\":{\"title\":\"You don't need to hire developers.\",\"titleHighlight\":\"You need to describe what you want.\",\"description\":\"The gap between your idea and real software used to be money, time, and technical skills. We closed that gap. Now the only thing between you and custom software is a conversation.\"},\"newFinalCta\":{\"title\":\"Your business should run on software built for it\",\"description\":\"Not generic tools. Not expensive custom dev.\",\"descriptionLine2\":\"Software that fits, built in minutes.\",\"button\":\"Start building\"},\"successStories\":{\"title\":\"Founders and Businesses building on BuildAI\"},\"newFaq\":{\"questions\":[{\"question\":\"Is this for real businesses?\",\"answer\":\"Yes—companies run operations, serve customers, and generate revenue on apps built here. BuildAI.Space powers real products used by thousands of users.\"},{\"question\":\"Can I build something complex?\",\"answer\":\"If you can describe it, you can build it. From simple tools to sophisticated business systems, our platform handles everything from customer-facing apps to internal operations.\"},{\"question\":\"Will it scale with my business?\",\"answer\":\"Built for growth from day one. Your apps are designed to handle increasing users, data, and complexity as your business grows.\"},{\"question\":\"What about my brand?\",\"answer\":\"Your domain, your logo, your colors—it's yours. Full branding control means your apps look and feel exactly like your business.\"}]},\"inspiration\":{\"seeUseCases\":\"See Use Cases\"}},\"instagramToApp\":{\"hero\":{\"title\":\"Create Digital Products for Your Instagram\",\"description\":\"Transform your Instagram expertise into profitable digital products - AI apps, courses, and tools your followers will love\",\"getStarted\":\"Get Started\"},\"form\":{\"usernamePlaceholder\":\"Instagram username\",\"consentText\":\"I own this Instagram account or have permission to use it from the owner.\",\"analyzing\":\"Analyzing Profile...\",\"analyzeButton\":\"Analyze Profile \u0026 Create Products\"},\"results\":{\"title\":\"Digital Product Ideas Ready!\",\"description\":\"We've analyzed your Instagram profile and created personalized digital product recommendations.\",\"blueprintTitle\":\"Your Product Blueprint\",\"editPlaceholder\":\"Edit your digital product blueprint...\",\"createButton\":\"Create Your Digital Products\"},\"features\":{\"title\":\"Turn Your Instagram Into Income\",\"description\":\"Create digital products that your followers actually want - powered by AI and built from your expertise\",\"aiPowered\":{\"title\":\"AI-Powered Products\",\"description\":\"Create intelligent tools and apps that provide real value to your Instagram audience.\"},\"monetize\":{\"title\":\"Monetize Your Expertise\",\"description\":\"Turn your Instagram knowledge into profitable digital products with built-in payment processing.\"},\"engage\":{\"title\":\"Engage Your Community\",\"description\":\"Give followers interactive experiences beyond likes and comments - build deeper connections.\"},\"brand\":{\"title\":\"Your Brand, Enhanced\",\"description\":\"Maintain your unique Instagram aesthetic while offering premium digital experiences.\"},\"mobile\":{\"title\":\"Mobile-First Design\",\"description\":\"Beautiful, responsive products that work perfectly on any device your audience uses.\"},\"launch\":{\"title\":\"Launch in Minutes\",\"description\":\"From Instagram analysis to live digital product - no coding or technical skills required.\"}},\"faq\":{\"title\":\"Frequently Asked Questions\",\"products\":{\"question\":\"What kind of digital products can I create?\",\"answer\":\"Create AI-powered apps, interactive courses, coaching tools, calculators, quizzes, and more - all tailored to your Instagram niche and expertise.\"},\"monetize\":{\"question\":\"How do I monetize my digital products?\",\"answer\":\"Built-in payment processing lets you sell one-time purchases, subscriptions, or premium memberships. Set your own prices and keep most of the revenue.\"},\"technical\":{\"question\":\"Do I need technical skills to create products?\",\"answer\":\"No coding required! Our AI analyzes your Instagram content and creates products automatically. You can customize everything through our visual editor.\"},\"analysis\":{\"question\":\"How does the Instagram analysis work?\",\"answer\":\"We analyze your public Instagram content to understand your expertise, audience, and brand voice, then suggest digital products that align with your niche.\"},\"customize\":{\"question\":\"Can I customize my digital products?\",\"answer\":\"Absolutely! After the initial creation, you have full control to customize design, features, content, and pricing through our intuitive no-code platform.\"},\"share\":{\"question\":\"How do I share products with my followers?\",\"answer\":\"Get a custom link to share in your Instagram bio, stories, or posts. Your products work beautifully on mobile and can be installed like native apps.\"},\"personal\":{\"question\":\"What if I don't have a business Instagram?\",\"answer\":\"Personal accounts work perfectly! We analyze your interests, posts, and engagement to suggest digital products that match your unique perspective and skills.\"}},\"cta\":{\"title\":\"Ready to Monetize Your Instagram?\",\"description\":\"Transform your Instagram expertise into profitable digital products that your followers will love and pay for.\",\"button\":\"Get Started Now\"},\"errors\":{\"usernameRequired\":\"Please enter an Instagram username\",\"consentRequired\":\"Please confirm you own this Instagram account or have permission to use it\"},\"success\":{\"analyzed\":\"Instagram profile analyzed! Create your digital products now\"}},\"pricing\":{\"hero\":{\"title\":\"Simple, Transparent Pricing\",\"description\":\"Start for free or choose a plan that grows with your business.\"},\"heroStarter\":{\"title\":\"Simple, Transparent Pricing\",\"description\":\"Choose a plan that grows with your business.\"},\"billing\":{\"monthly\":\"Monthly\",\"yearly\":\"Yearly\",\"save\":\"Save 20%\"},\"plans\":{\"discover\":{\"name\":\"Discover\",\"description\":\"Try it out and explore the basics\",\"buttonText\":\"Get Started Free\"},\"rocket\":{\"name\":\"Rocket\",\"description\":\"Build your online business\",\"buttonText\":\"Get Rocket\"},\"moon\":{\"name\":\"Moon\",\"description\":\"Launch your online business\",\"buttonText\":\"Get Moon\"},\"spaceship\":{\"name\":\"Spaceship\",\"description\":\"Scale your online business\",\"buttonText\":\"Get Spaceship\"},\"galaxy\":{\"name\":\"Galaxy\",\"description\":\"Maximize growth and revenue\",\"buttonText\":\"Get Galaxy\"}},\"features\":{\"oneApp\":\"1 Space App\",\"unlimitedApps\":\"Unlimited Apps\",\"builderMessages20\":\"20 builder messages per month (5 per day)\",\"builderMessages100\":\"100 builder messages per month\",\"builderMessages250\":\"250 builder messages per month\",\"builderMessages500\":\"500 builder messages per month\",\"aiCredits20\":\"20 monthly AI credits\",\"aiCredits1000\":\"1,000 monthly AI credits\",\"aiCredits5000\":\"5,000 monthly AI credits\",\"aiCredits15000\":\"15,000 monthly AI credits\",\"aiAppLink\":\"AI App link\",\"publishApps\":\"Publish apps\",\"customDomain\":\"Custom domain\",\"removeBranding\":\"Remove BuildAI watermark\",\"prioritySupport\":\"Priority support\",\"premiumSupport\":\"Premium support\",\"paymentSystem\":\"Payment system for users\",\"customIntegrations\":\"Custom integrations\",\"builderMessages1200\":\"1,200 builder messages per month\",\"aiCredits40000\":\"40,000 monthly AI credits\",\"agents\":\"digital employees (uses your messages \u0026 credits)\",\"agents1\":\"1 Digital Employee\",\"agents3\":\"3 Digital Employees\",\"agents6\":\"6 Digital Employees\",\"agents10\":\"10 Digital Employees\",\"agents20\":\"20 Digital Employees\"},\"comparison\":{\"title\":\"Compare Plans\",\"description\":\"Find the perfect plan for your Online Business with our detailed feature comparison.\",\"featuresColumn\":\"Features\",\"mostPopular\":\"Most Popular\",\"spaceApps\":\"Space Apps\",\"monthlyCredits\":\"Monthly AI Credits\",\"builderMessages\":\"Builder Messages\",\"agents\":\"Digital Employees\",\"aiAppLink\":\"AI App Link\",\"publishApps\":\"Publish Apps\",\"removeBranding\":\"Remove BuildAI Watermark\",\"customDomain\":\"Custom Domain\",\"supportLevel\":\"Support Level\",\"paymentSystem\":\"Payment System\",\"customIntegrations\":\"Custom Integrations\",\"unlimited\":\"Unlimited\",\"supportStandard\":\"Standard\",\"supportPriority\":\"Priority\",\"supportPremium\":\"Premium\",\"billedAnnually\":\"billed annually\"},\"buildForYou\":{\"title\":\"Build-For-You Service\",\"description\":\"Prefer a hands-off setup? We'll create your app using BuildAI, and you can continue editing anytime.\",\"buttonText\":\"Get a Quote\"},\"faq\":{\"title\":\"Frequently Asked Questions\",\"description\":\"Find answers to common questions about our pricing plans and Online Business features.\",\"questions\":[{\"question\":\"Do I need technical skills to build my app?\",\"answer\":\"Not at all. Simply describe what you want, and we'll build it for you. No coding required.\"},{\"question\":\"How quickly can I get started?\",\"answer\":\"You can start building immediately after signing up. Most entrepreneurs launch their apps within days, not months.\"},{\"question\":\"What are builder messages?\",\"answer\":\"Builder messages let you tell our AI what to create or modify on your app. Each message counts as one builder message.\"},{\"question\":\"What are AI credits?\",\"answer\":\"AI credits are used when your app uses AI to help your users. Different AI features use different amounts of credits.\"},{\"question\":\"Can I customize how my app looks?\",\"answer\":\"Yes! You can customize colors, logos, and layouts to match your brand. Premium plans also allow you to use your own domain with no BuildAI branding.\"},{\"question\":\"How does the payment system work?\",\"answer\":\"The Moon \u0026 Spaceship plans include a payment system that lets your users pay you. BuildAI charges a platform fee on transactions, plus any fees from the payment provider. We handle all the payment processing infrastructure for you.\"}]},\"cta\":{\"title\":\"Ready to Launch Your Online Business?\",\"description\":\"No coding required. Just describe your idea and we'll build it.\",\"button\":\"Get Started Free\"},\"ctaStarter\":{\"title\":\"Ready to Launch Your Online Business?\",\"description\":\"No coding required. Just describe your idea and we'll build it.\",\"button\":\"Get Started\"}},\"templates\":{\"hero\":{\"title\":\"AI App Templates\",\"description\":\"Browse our collection of ready-to-use AI app templates. Find the perfect starting point for your next project and customize it to fit your needs.\"},\"filter\":{\"all\":\"All\"},\"noResults\":{\"title\":\"No templates found\",\"description\":\"Try adjusting your search or filter criteria.\",\"featuredTitle\":\"No featured templates found\"},\"card\":{\"featured\":\"Featured\",\"moreDetails\":\"More Details\",\"viewDemo\":\"View Demo\"},\"cta\":{\"title\":\"Can't find what you're looking for?\",\"description\":\"Create a custom App from scratch with our powerful builder. Describe what you need, and we'll build it for you.\",\"button\":\"Build My App\"}},\"affiliate\":{\"hero\":{\"title\":\"Join BuildAI Affiliates\",\"description\":\"Become an affiliate and earn 20% recurring commission for sharing our revolutionary no-code AI app builder with your network.\",\"button\":\"Start Earning Now\"},\"payment\":{\"title\":\"Get Paid for Accelerating Innovation\",\"description\":\"Earn generous 20% recurring commissions for each premium plan referral. Help others transform their ideas into AI-powered apps while building a rewarding passive income stream.\",\"recurringTitle\":\"20% Recurring\",\"recurringDescription\":\"Earn 20% commission for the lifetime of each customer subscription. Continue earning as long as they stay subscribed.\",\"trackingTitle\":\"30-Day Tracking\",\"trackingDescription\":\"Extended 30-day cookie duration ensures you get credit for referrals even if users don't convert immediately.\",\"marketTitle\":\"Growing Market\",\"marketDescription\":\"Join the booming no-code revolution. BuildAI is at the forefront of democratizing app development with AI.\"},\"howItWorks\":{\"title\":\"How It Works\",\"description\":\"Join our affiliate program and earn rewards by sharing BuildAI with your network. It's simple to get started and start earning commissions.\",\"steps\":[{\"title\":\"Join Our Program\",\"description\":\"Sign up for the BuildAI Affiliate Program and receive your unique affiliate link to start earning.\"},{\"title\":\"Share BuildAI\",\"description\":\"Promote your affiliate link to your network. When visitors click your link, they have 30 days to sign up for commission eligibility.\"},{\"title\":\"Earn Recurring Commissions\",\"description\":\"Get rewarded with 20% recurring commission for every user who upgrades to BuildAI's premium plans through your referral.\"}]},\"guidelines\":{\"title\":\"Guidelines for Success\",\"doTitle\":\"Please DO\",\"dontTitle\":\"Please DON'T\",\"dos\":[\"Use branding from our brand assets or content from our social media\",\"Place your affiliate link in blogs, comparisons, social media posts\",\"Promote BuildAI authentically to your audience\",\"Share success stories and user testimonials\"],\"donts\":[\"Use your affiliate link on sites with adult or illegal content\",\"Promote BuildAI without following our branding guidelines\",\"Use fraudulent or misleading marketing tactics\",\"Abuse the program or create fake accounts\",\"Run Google Ads or other prohibited advertising channels\"]},\"whyUsers\":{\"title\":\"Why Users Love BuildAI\",\"description\":\"Entrepreneurs and creators across the globe are raving about BuildAI's ability to transform their ideas into reality. Here's why our users recommend us to their networks:\",\"benefits\":[\"Users save thousands of dollars and countless hours by building their own custom apps with BuildAI\",\"Entrepreneurs love our no-code AI app builder that requires zero technical skills\",\"Creators praise our flexible AI system that adapts to their expertise\",\"Businesses are amazed by the instant app creation and rapid deployment\",\"Teams appreciate how BuildAI democratizes app development for everyone\"]},\"faq\":{\"title\":\"Frequently Asked Questions\",\"description\":\"Everything you need to know about the BuildAI Affiliate Program\",\"questions\":[{\"question\":\"What are the conditions for a qualified referral?\",\"answer\":\"A qualified referral occurs when someone clicks your affiliate link and upgrades to any of our premium plans within 30 days. The user must be new to BuildAI and complete the payment process.\"},{\"question\":\"How long does the referral tracking last?\",\"answer\":\"Referral tracking lasts for 30 days from when someone first clicks your affiliate link. If they sign up and upgrade within this window, you'll receive credit for the referral.\"},{\"question\":\"What commission rate and duration do you offer?\",\"answer\":\"We offer a 20% recurring commission for the lifetime of the customer subscription. This means you continue earning as long as your referred customer remains subscribed to our platform.\"},{\"question\":\"When do I receive my affiliate payments?\",\"answer\":\"Affiliate payments are processed every other Friday. After 7 days from the sale, your commission becomes available for payout. You can track earnings in your affiliate dashboard.\"},{\"question\":\"What if someone clicks multiple affiliate links?\",\"answer\":\"The most recent affiliate link clicked gets credited with the sale. Our system tracks this with cookies, and the affiliate whose link was clicked last (within the 30-day window) earns the commission.\"},{\"question\":\"What happens if a customer gets a refund?\",\"answer\":\"If we issue a refund, the affiliate commission is automatically deducted from your balance. The refund experience is the same whether an affiliate is involved or not.\"},{\"question\":\"Have any questions about the affiliate program?\",\"answer\":\"Please contact us at hello@buildai.space and we'll be happy to help you.\"}]},\"cta\":{\"title\":\"Ready to Start Earning?\",\"description\":\"Join our affiliate program today and start earning recurring commissions by sharing the future of no-code AI app development.\",\"button\":\"Apply Now\"}},\"talkMode\":{\"tips\":[\"Hey there! Your app is being generated right now. While we wait, let me tell you what I can do...\",\"You can have a real conversation with me! Just talk naturally about what you want to build, and I'll help you create it.\",\"Prefer typing? No problem! You can talk to me or just type your messages - whatever feels more comfortable for you.\",\"Try sharing your screen with me! I can see exactly what you're looking at and help you make changes by just describing them.\",\"See something you want to change? Click on any element in your app and tell me what to do - colors, text, layout, anything!\",\"When your app is ready, I'll move to the bottom of the screen. You can ask me for new features or tweaks anytime you want.\",\"I'll let you know as soon as your app is ready! In the meantime, feel free to click on me to start voice mode early.\"],\"completionTip\":\"Your app is ready! Click on me to start voice mode, or just type below to chat.\",\"status\":{\"voiceReady\":\"Voice mode is ready\",\"connecting\":\"Connecting to voice mode...\",\"clickToStart\":\"Click the logo to start voice mode\",\"waitForApp\":\"Or wait for your app to be ready\",\"typeMessage\":\"Type a message...\",\"connectingPlaceholder\":\"Connecting to help you ideate...\"}}},\"now\":\"$undefined\",\"timeZone\":\"UTC\",\"children\":\"$L1f\"}]\n"])</script><script>self.__next_f.push([1,"1f:[\"$\",\"$L20\",null,{\"children\":[\"$\",\"$L6\",null,{\"parallelRouterKey\":\"children\",\"error\":\"$undefined\",\"errorStyles\":\"$undefined\",\"errorScripts\":\"$undefined\",\"template\":[\"$\",\"$L14\",null,{}],\"templateStyles\":\"$undefined\",\"templateScripts\":\"$undefined\",\"notFound\":[[[\"$\",\"title\",null,{\